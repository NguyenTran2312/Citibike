# Citi Bike local stack - environment template.
#
#   cp .env.example .env      # then edit .env
#
# .env is git-ignored. Never commit real passwords; the values below are
# placeholders for local development only. Every variable is optional:
# docker-compose.yml falls back to the same local defaults when one is unset.

# --- MinIO (S3 object storage: raw, warehouse, checkpoints, quarantine) -------
# Also used as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY by Spark, Trino, Python.
MINIO_ROOT_USER=citibike
# at least 8 characters
MINIO_ROOT_PASSWORD=change-me-minio

# --- PostgreSQL (serving DB: station_status_latest, active_alerts) ------------
# The user/password are applied only when the postgres-data volume is first created.
POSTGRES_USER=citibike
POSTGRES_PASSWORD=change-me-postgres

# --- Grafana ------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-grafana

# --- Airflow (optional profile: docker compose --profile airflow up -d) -------
# If AIRFLOW_DB_PASSWORD contains URL special characters (@ : / ? # %), URL-encode it.
AIRFLOW_UID=50000
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=change-me-airflow
AIRFLOW_DB_PASSWORD=change-me-airflow-db
AIRFLOW_SECRET_KEY=change-me-random-string

# --- Pipeline tuning ----------------------------------------------------------
# LOW_BIKES alert when bikes <= threshold
LOW_BIKES_THRESHOLD=2
# STALE alert when now - last_reported > this
STALE_AFTER_SECONDS=180
# Spark Structured Streaming trigger
STREAM_TRIGGER_INTERVAL=5 minutes

# --- Spark worker resources -----------------------------------------------------
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=4g

# --- Host ports (bound to 127.0.0.1 only) ---------------------------------------
# Keep the defaults; if a port is busy, stop whatever holds it (see infra/README.md).
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ICEBERG_REST_PORT=8181
KAFKA_PORT=9092
POSTGRES_PORT=5432
SPARK_UI_PORT=8081
SPARK_WORKER_UI_PORT=8082
TRINO_PORT=8080
GRAFANA_PORT=3000
AIRFLOW_PORT=8083

# --- Image overrides (leave unset to use the pinned defaults) ------------------
# MINIO_IMAGE=bitnamilegacy/minio:2025.4.22
# MINIO_MC_IMAGE=bitnamilegacy/minio-client:2025.4.16
# ICEBERG_REST_IMAGE=apache/iceberg-rest-fixture@sha256:009f9f6897cc1e8fd6e8133c401c7a3e7c333c71293a621d06a71570ae989c29
# CURL_IMAGE=curlimages/curl:8.11.1
